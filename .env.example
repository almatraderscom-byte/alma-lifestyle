# =============================================================================
# Alma Lifestyle — Environment variables
# Copy to `.env.local` for development.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL connection string — migrations, scripts, optional ORM)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://username:password@localhost:5432/alma_lifestyle

# -----------------------------------------------------------------------------
# Supabase (required for storefront & server data layer)
# -----------------------------------------------------------------------------
# Project URL — Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / public key — safe for browser (respects RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY, never expose to the client (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Authentication (admin / customer sessions — when enabled)
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=generate-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Payments & messaging (optional until integrated)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
WHATSAPP_API_KEY=
