# =============================================================================
# Alma Lifestyle — Environment variables
# Copy to `.env.local` for development.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Do not set NODE_ENV here — Next.js sets it automatically (development vs production).
# Local dev; production must be https://almatraders.com (canonical, no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_SLUG=alma-lifestyle

# Set to false to force localStorage admin mode even when Supabase is configured
# NEXT_PUBLIC_USE_API=false

# -----------------------------------------------------------------------------
# Supabase (required for API + database mode)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Database (optional — for direct psql / migration scripts)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://username:password@localhost:5432/alma_lifestyle

# -----------------------------------------------------------------------------
# Admin session (required — min 32 characters; sign HttpOnly alma_admin_session cookie)
# -----------------------------------------------------------------------------
ADMIN_SESSION_SECRET=generate-a-random-secret-at-least-32-characters-long
# Supabase Auth: create the user in the dashboard and add a row to admin_users (role admin|editor)

# -----------------------------------------------------------------------------
# Auth (optional)
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=generate-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Payments & messaging (optional)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
WHATSAPP_API_KEY=
