# =============================================================================
# Alma Lifestyle — Environment variables
# Copy to `.env.local` for development.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# Do not set NODE_ENV here — Next.js sets it automatically (development vs production).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_SLUG=alma-lifestyle

# Set to false to force localStorage admin mode even when Supabase is configured
# NEXT_PUBLIC_USE_API=false

# -----------------------------------------------------------------------------
# Supabase (required for API + database mode)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Database (optional — for direct psql / migration scripts)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://username:password@localhost:5432/alma_lifestyle

# -----------------------------------------------------------------------------
# Admin (legacy dev login when Supabase Auth is not used)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@alma.com
# For Supabase Auth, create the user in the dashboard and add to admin_users table

# -----------------------------------------------------------------------------
# Auth (optional)
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET=generate-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Email (Resend) — transactional order emails
# -----------------------------------------------------------------------------
RESEND_API_KEY=
# Verified sender on your domain (Resend dashboard)
FROM_EMAIL=orders@almatraders.com
FROM_NAME=ALMA Lifestyle
REPLY_TO_EMAIL=admin@almatraders.com
# Production site URL (logo fallback + email links)
NEXT_PUBLIC_SITE_URL=https://almatraders.com

# -----------------------------------------------------------------------------
# Payments & messaging (optional)
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
WHATSAPP_API_KEY=
CALLMEBOT_API_KEY=
ADMIN_WHATSAPP_NUMBER=
