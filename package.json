{
  "name": "alma-lifestyle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/ensure-env.mjs && npm run check-assets",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "verify:production": "node scripts/verify-production-readiness.mjs",
    "bootstrap:supabase": "node scripts/bootstrap-supabase-prod.mjs",
    "ensure:storage": "node scripts/ensure-storage-buckets.mjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:pixel": "node scripts/pretest-pixel.mjs && playwright test tests/pixel-events.spec.ts",
    "test:pixel:ui": "playwright test --ui tests/pixel-events.spec.ts",
    "test:pixel:report": "playwright show-report",
    "test:pixel:debug": "playwright test --debug tests/pixel-events.spec.ts",
    "test:pixel:prod": "playwright test tests/pixel-production.spec.ts --config=playwright.production.config.ts",
    "verify:pixel:prod": "tsx scripts/verify-pixel-production.ts",
    "pre-launch-check": "tsx scripts/pre-ad-launch-check.ts",
    "check-assets": "tsx scripts/check-no-demo-assets.ts",
    "check": "npm run type-check && npm run check-assets",
    "prebuild": "npm run check-assets"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.0",
    "framer-motion": "^11.1.7",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.4",
    "tailwind-merge": "^2.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^1.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jsdom": "^24.0.0",
    "playwright": "^1.49.0",
    "prettier": "^3.2.5",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^1.3.1"
  }
}
