# =============================================================================
# Vercel production environment variables (reference only — do not commit secrets)
# Copy each key into: Vercel Dashboard → Project → Settings → Environment Variables
# =============================================================================

# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon key (public — safe in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role (SECRET — Production + Preview only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site URL (no trailing slash) — required for sitemap, canonicals, Open Graph
NEXT_PUBLIC_APP_URL=https://almatraders.com

# Brand slug used for multi-tenant queries (default: alma-lifestyle)
NEXT_PUBLIC_BRAND_SLUG=alma-lifestyle

# Required for admin + storefront to load data from Supabase (do NOT set to false in production)
NEXT_PUBLIC_USE_API=true

# NODE_ENV: Vercel sets "production" automatically — you do NOT need to add it in the dashboard.

# Optional: force localStorage admin mode even when Supabase is configured (dev only)
# NEXT_PUBLIC_USE_API=false

# Optional: Sentry (install @sentry/nextjs and configure instrumentation.ts)
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Admin session signing secret (SECRET — min 32 characters; rotate to invalidate all sessions)
ADMIN_SESSION_SECRET=generate-a-random-secret-at-least-32-characters-long
